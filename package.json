{
  "name": "ameing-gifts-backend",
  "version": "1.0.0",
  "description": "Backend לאתר מתנות במיתוג אישי: Express, TypeScript, PostgreSQL, Prisma, JWT, Swagger",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run build && npm test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed/run.ts",
    "db:seed:prod": "node dist/db/seed/run.js",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "docs:generate": "tsx src/docs/generate-openapi.ts",
    "render-build": "npm install --include=dev && npm run build && prisma migrate deploy && npm run db:seed:prod",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/db/seed/run.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.16.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
