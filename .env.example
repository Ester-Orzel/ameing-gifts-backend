# העתיקי את הקובץ הזה לקובץ חדש בשם .env ומלאי את הערכים.
# את הקובץ .env לא מעלים ל-GitHub (הוא כבר מופיע ב-.gitignore).

# סביבת הרצה: development / production / test
NODE_ENV=development

# הפורט שהשרת מאזין לו. ב-Render הפורט נקבע אוטומטית.
PORT=3000

# כתובת החיבור למסד הנתונים PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gifts_dev?schema=public"

# מסד נתונים נפרד לבדיקות האוטומטיות. הבדיקות מוחקות בו את כל הנתונים!
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gifts_test?schema=public"

# מפתח סודי לחתימת JWT. לפחות 32 תווים אקראיים. לעולם לא לשתף.
# אפשר ליצור כך: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# תוקף ה-Token בדקות (120 = שעתיים)
JWT_EXPIRES_MINUTES=120

# כתובות האתרים שמותר להם לפנות לשרת (צד ה-React), מופרדות בפסיק.
# כוכבית (*) מתירה לכל כתובת - מתאים רק לפיתוח.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- נתוני הדגמה (Seed) ----------
# חשבון המנהל. בפיתוח, אם לא מוגדר, נוצר admin@example.com עם הסיסמה Admin1234!
# בפרודקשן חובה להגדיר סיסמה חזקה משלך.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=מנהל החנות
SEED_ADMIN_PHONE=0500000000

# האם ליצור לקוחות והזמנות לדוגמה. בפיתוח: כן כברירת מחדל.
# בפרודקשן נוצרים רק אם SEED_DEMO_DATA=true וגם הוגדרה סיסמה ב-SEED_DEMO_PASSWORD.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=
